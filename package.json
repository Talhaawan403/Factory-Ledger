{
  "name": "factory-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/oxlint/bin/oxlint",
    "typecheck:tests": "node ./node_modules/typescript/bin/tsc -p tsconfig.tests.json",
    "test": "node ./node_modules/vitest/vitest.mjs run --exclude 'tests/rules/**'",
    "test:rules": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore --project demo-factory-ledger \"node ./node_modules/vitest/vitest.mjs run tests/rules\"",
    "verify:release": "bash scripts/verify-release-readiness.sh",
    "generate:icons": "python3 scripts/generate_app_icons.py",
    "deploy:android": "npm run build && npx cap sync android && cd android && bash ./gradlew assembleDebug && adb install -r app/build/outputs/apk/debug/app-debug.apk && adb shell monkey -p com.factoryledger.app -c android.intent.category.LAUNCHER 1",
    "seed:device": "adb shell am start -n com.factoryledger.app/com.coalledger.app.MainActivity --ez devSeed true",
    "seed:url": "adb shell am start -a android.intent.action.VIEW -d \"factoryledger://seed\" com.factoryledger.app",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "firebase": "node ./node_modules/firebase-tools/lib/bin/firebase.js",
    "deploy:rules": "node ./node_modules/firebase-tools/lib/bin/firebase.js deploy --only firestore:rules --project factories-ledger"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.33.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
